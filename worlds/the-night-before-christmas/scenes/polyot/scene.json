  "music": {
    "prompts": [
      {
        "text": "Soaring warm synth pads and slow rising strings, night flight over snow, vast and weightless, cinematic indie game",
        "weight": 1.2
      },
      {
        "text": "Sparse felt piano notes falling into deep reverb, stars passing, minimal and luminous",
        "weight": 0.8
      },
      {
        "text": "Airy wind texture and soft whooshing noise, the sense of height and speed, ambient",
        "weight": 0.6
      },
      {
        "text": "Glassy celesta and bowed vibraphone shimmering, moonlight on frost, delicate",
        "weight": 0.4
      },
      {
        "text": "Tsymbaly hammered dulcimer in fast soft tremolo over a drone, Ukrainian colour, flight",
        "weight": 0
      },
      {
        "text": "Bandura arpeggios played with wonder, open fifths, modern folk minimalism",
        "weight": 0
      },
      {
        "text": "Driving low strings ostinato, a reckless ride on a devil's back, playful tension",
        "weight": 0
      },
      {
        "text": "Mischievous pizzicato and bassoon, comic folk-tale devil, tiptoeing rhythm",
        "weight": 0
      },
      {
        "text": "Journey-like solo cello over a huge empty landscape, awe",
        "weight": 0
      },
      {
        "text": "Sopilka wooden flute melody carried by wind, distant, nostalgic",
        "weight": 0
      },
      {
        "text": "Glittering music box motif sped up and slowed down, a city of lights far below",
        "weight": 0
      },
      {
        "text": "Baroque harpsichord and chamber strings, candlelit palace of Saint Petersburg, gold and ice",
        "weight": 0
      },
      {
        "text": "Distant cathedral bells across a frozen river, slow and grand",
        "weight": 0
      },
      {
        "text": "Analog synth arpeggio rising and falling like breathing, Alto's Odyssey night level",
        "weight": 0
      },
      {
        "text": "Granular choir-like pad without words, clouds passing through, soft",
        "weight": 0
      },
      {
        "text": "Dawn: warm brass swells and bright bells, the sky turning pink, homecoming",
        "weight": 0
      },
      {
        "text": "Deep sub drone and tense strings, falling through cloud, vertigo",
        "weight": 0
      },
      {
        "text": "Lo-fi tape warble and soft crackle, a tender memory of flying",
        "weight": 0
      }
