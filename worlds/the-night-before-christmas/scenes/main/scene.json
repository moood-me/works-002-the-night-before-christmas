    "prompts": [
      {
        "text": "Sparse felt piano in a wide reverb, single slow notes like falling snow, winter night, minimal, modern ambient",
        "weight": 1.2
      },
      {
        "text": "Warm analog synth pads swelling slowly, deep blue night, cinematic indie game ambient, vast and quiet",
        "weight": 1
      },
      {
        "text": "Glassy celesta and music box motifs, delicate and distant, frosty sparkle over long silence",
        "weight": 0.7
      },
      {
        "text": "Tsymbaly hammered dulcimer in soft shimmering tremolo, Ukrainian colour, slow and luminous",
        "weight": 0.5
      },
      {
        "text": "Solo bandura plucked softly with long pauses, old Ukrainian mode played in a modern minimal way",
        "weight": 0
      },
      {
        "text": "Breathy sopilka wooden flute carol-like melody over a low drone, intimate, nocturnal",
        "weight": 0
      },
      {
        "text": "Bowed glass and crystal harmonics, high shimmering overtones, cold clear air",
        "weight": 0
      },
      {
        "text": "Distant sleigh bells, very soft and unhurried, quiet festive night",
        "weight": 0
      },
      {
        "text": "Solo cello drone with slow tender phrases, melancholic, starlit",
        "weight": 0
      },
      {
        "text": "Journey-like cello and harp over a vast empty landscape, awe and stillness",
        "weight": 0
      },
      {
        "text": "Minimalist piano and strings arpeggios in the style of Olafur Arnalds, hopeful, gentle",
        "weight": 0
      },
      {
        "text": "Lo-fi tape-warped piano lullaby with soft crackle, warm and nostalgic",
        "weight": 0
      },
      {
        "text": "Accordion breathing slow chords, warmth behind frosted windows of a village house",
        "weight": 0
      },
      {
        "text": "Granular ambient texture of wind and snow, soft hiss, field-recording feel",
        "weight": 0
      },
      {
        "text": "Kalimba patterns in an odd meter, playful and light, a hidden mischief",
        "weight": 0
      },
      {
        "text": "Sneaking pizzicato strings and bassoon, comic folk-tale mischief, a devil tiptoeing",
        "weight": 0
      },
      {
        "text": "Distant church bell tolling now and then over silent snow, airy drones",
        "weight": 0
      },
      {
        "text": "Dark low brass drone and sub bass, the moon gone, ominous stillness",
        "weight": 0
      },
      {
        "text": "Swirling wind synths and rushing noise, blizzard, lost in the dark",
        "weight": 0
      },
      {
        "text": "Rising strings and bright bells, dawn breaking pink over snow, Christmas morning",
